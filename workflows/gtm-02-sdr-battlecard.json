      "id": "768ff31f-517e-4155-b66d-5427ab5bdd9e",
      "name": "Retrieve battlecard passages",
      "type": "@llamaindex/n8n-nodes-llamacloud.llamaParsePlatformTool",
      "typeVersion": 1,
      "position": [
        480,
        336
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Use for SDR call-prep questions answerable from the battlecard index (pains, differentiators, pricing notes, objections, case studies). Input is a natural-language query. Returns grounded passages with file and page refs. Use when the question is conceptual or spans multiple docs.",
        "operation": "retrieveIndex",
        "indexId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_INDEX_ID"
        },
        "topK": 5
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
