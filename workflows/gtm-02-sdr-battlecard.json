        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "llamaParseApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"index_id\": \"YOUR_INDEX_ID\", \"file_id\": \"{{ $fromAi('file_id', 'ID of the file to search, from find or retrieve results') }}\", \"pattern\": \"{{ $fromAi('pattern', 'Regex for the exact term, ID, heading or clause to find') }}\", \"context_chars\": 200}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
