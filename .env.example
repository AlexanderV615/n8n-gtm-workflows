# copy to .env, never commit .env
# gtm-01: Google OAuth (n8n UI) + Jina Bearer key + Qdrant URL
GOOGLE_CREDENTIAL=n8n-ui
JINA_API_KEY=
QDRANT_URL=http://qdrant:6333
# gtm-02: OpenAI + LlamaCloud (n8n UI), index from gtm-01 corpus or §2 list
OPENAI_API_KEY=
LLAMA_CLOUD_API_KEY=
LLAMA_BASE=https://api.cloud.llamaindex.ai/api/v1
# gtm-03: Cal.com (n8n UI) + webhook secret + your event type IDs
CAL_API_KEY=
VAPI_WEBHOOK_SECRET=
